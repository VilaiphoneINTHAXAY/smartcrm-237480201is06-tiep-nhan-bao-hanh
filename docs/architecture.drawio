<mxCell id="OOS" value="NGOÀI PHẠM VI (WON&amp;#x27;T)&lt;br&gt;&lt;br&gt;• Phân công kỹ thuật viên (L4)&lt;br&gt;• Tồn kho linh kiện (L5)&lt;br&gt;• Khảo sát hài lòng (L8)&lt;br&gt;• Gửi SMS/Zalo cho khách&lt;br&gt;• Triển khai, hạ tầng, cân bằng tải&lt;br&gt;&lt;br&gt;Phiếu ở trạng thái MỚI là&lt;br&gt;đầu ra bàn giao cho L4." style="align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fillColor=#fff5f5;strokeColor=#9c2f2f;strokeWidth=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#7a1f1f;dashed=1;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="260" height="250" as="geometry"/></mxCell>
