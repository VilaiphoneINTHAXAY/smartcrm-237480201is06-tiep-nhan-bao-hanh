# Cổng chạy API
PORT=3000

# Đường dẫn tệp CSDL SQLite (tự tạo khi chạy npm run migrate)
DB_PATH=data/smartcrm.db

# Thời gian hết phiên đăng nhập (NFR-06)
SESSION_TIMEOUT_MINUTES=30

# Địa chỉ giao diện được phép gọi API (CORS) – giao diện Vite chạy ở cổng 5173
FRONTEND_ORIGIN=http://localhost:5173

# Mật khẩu DEMO đặt cho tài khoản mẫu nv01, nv02, ql01 khi chạy npm run migrate (chỉ để chạy thử cục bộ).
# Không bắt buộc – bỏ trống thì dùng Demo@123 như README. Đổi giá trị này trước khi chạy migrate nếu muốn mật khẩu khác.
DEMO_PASSWORD=Demo@123

# (Chỉ dùng với docker compose) Cổng mở ra máy thật. Đổi nếu cổng 3000 / 5173 đang bận.
APP_PORT=3000
WEB_PORT=5173
